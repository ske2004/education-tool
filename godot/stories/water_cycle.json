	"characters": [
		{
			"id": "mayor",
			"name": "Mayor Lena",
			"place": "village",
			"pos": [
				-2,
				-0.5
			],
			"color": "#7b5ea7",
			"lines": [
				{
					"text": "Thank goodness you're here! Our well is nearly dry, and nobody knows where all the water goes. Librarian Omar reads about everything. Will you find out for us?",
					"opens": true,
					"choices": [
						{
							"text": "I'll find out!",
							"next": -1,
							"sets": "quest"
						},
						{
							"text": "Where is the library?",
							"next": 1
						}
					],
					"unless": "learned_cycle"
				},
				{
					"text": "It's the blue house on the east side of the square. Walk up to its door and press E.",
					"opens": false,
					"choices": [
						{
							"text": "Thanks, I'm on my way.",
							"next": -1,
							"sets": "quest"
						}
					]
				},
				{
					"text": "You're back! So tell me: where does our water go?",
					"opens": true,
					"choices": [
						{
							"text": "The sun warms it, and it rises into the air as vapour.",
							"next": 3
						},
						{
							"text": "It sinks to the centre of the Earth.",
							"next": 4
						}
					],
					"requires": "learned_cycle"
				},
				{
					"text": "Into the air? Then what happens to it up there?",
					"opens": false,
					"choices": [
						{
							"text": "It cools, turns into clouds and falls again as rain.",
							"next": 5
						},
						{
							"text": "It stays up there forever.",
							"next": 4
						}
					]
				},
				{
					"text": "Hmm, that doesn't sound like something Omar would say.",
					"opens": false,
					"choices": [
						{
							"text": "Let me think again.",
							"next": 2
						}
					]
				},
				{
					"text": "So the water comes back as rain! If we catch it in barrels, the well can rest. Thank you, you've saved the village!",
					"opens": false,
					"choices": [
						{
							"text": "Glad I could help.",
							"next": -1,
							"ending": "The village built rain barrels, and the well never ran dry again. You explained the water cycle: evaporation, condensation and precipitation."
						}
					]
				}
			]
		},
		{
			"id": "farmer",
			"name": "Farmer Pia",
			"place": "village",
			"pos": [
				-7,
				7
			],
			"rot": 30,
			"color": "#d08c3c",
			"lines": [
				{
					"text": "Morning! On hot days the puddles in my field are gone by lunchtime. My grandma said the sun drinks them.",
					"opens": true,
					"choices": [
						{
							"text": "Where do you think the water really goes?",
							"next": 1
						},
						{
							"text": "Have a nice day!",
							"next": -1
						}
					]
				},
				{
					"text": "Up, I suppose, but I've never seen water fly! Ask Omar at the library, he knows these things.",
					"opens": false,
					"choices": [
						{
							"text": "I will.",
							"next": -1
						}
					]
				}
			]
		},
		{
			"id": "librarian",
			"name": "Librarian Omar",
			"place": "library",
			"pos": [
				3.5,
				-3
			],
			"color": "#3f8f8b",
			"lines": [
				{
					"text": "Welcome to the library! Water is always on a journey we call the water cycle. I left a notebook about it on the table. Read it, then come and see me.",
					"opens": true,
					"choices": [
						{
							"text": "I'll take a look.",
							"next": -1
						}
					],
					"unless": "notebook"
				},
				{
					"text": "Ah, you found my cloud notebook. Let's see what you learned. What happens when water vapour cools down high in the sky?",
					"opens": true,
					"choices": [
						{
							"text": "It forms tiny droplets, and they make clouds.",
							"next": 2
						},
						{
							"text": "It catches fire.",
							"next": 3
						}
					],
					"requires": "notebook",
					"unless": "learned_cycle"
				},
				{
					"text": "Exactly! That's condensation. When the droplets grow heavy, they fall as rain or snow: precipitation. Go and tell the mayor!",
					"opens": false,
					"choices": [
						{
							"text": "Thanks, Omar!",
							"next": -1,
							"sets": "learned_cycle"
						}
					]
				},
				{
					"text": "Not quite! Have another look at the notebook, then try again.",
					"opens": false,
					"choices": [
						{
							"text": "Let me try again.",
							"next": 1
						}
					]
				},
				{
					"text": "Off you go, the mayor is waiting!",
					"opens": true,
					"choices": [
						{
							"text": "On my way.",
							"next": -1
						}
					],
					"requires": "learned_cycle"
				}
			]
		}
	],
	"items": [
		{
			"id": "notebook",
			"name": "Cloud notebook",
			"place": "library",
			"pos": [
				0,
				0
			],
			"color": "#f2c14e",
			"description": "Evaporation: the sun warms water, and it rises into the air as invisible vapour.\nCondensation: high up, the vapour cools into tiny droplets that make clouds.\nPrecipitation: when the droplets get heavy, they fall as rain or snow."
		}
	]
